rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'arijalibnujati@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Optical Catalog
    match /frames/{frameId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(frameId);
    }

    // User Saved Virtual Try-On Looks
    // Only signed-in owners may read or write their own looks; guests keep looks in localStorage.
    match /tryOnLooks/{lookId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(lookId) && isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Orders with custom lenses
    // Orders contain customer PII (name, email, address): never publicly readable.
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isValidId(orderId)
                    && request.resource.data.customerEmail is string
                    && ((isSignedIn() && request.resource.data.userId == request.auth.uid)
                        || (!isSignedIn() && request.resource.data.userId == 'guest-checkout'));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
