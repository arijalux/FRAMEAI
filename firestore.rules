rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Users collection
    match /users/{userId} {
      allow read, write: if true;
    }

    // Sellers collection
    match /sellers/{sellerId} {
      allow read, write: if true;
    }

    // Products collection
    match /products/{productId} {
      allow read, write: if true;
    }

    // Wishlists collection (doc per user or list)
    match /wishlists/{userId} {
      allow read, write: if true;
    }

    // Cart items collection (keyed by user or cartId)
    match /carts/{userId} {
      allow read, write: if true;
    }

    // Orders collection
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Try-on sessions collection
    match /tryOnSessions/{sessionId} {
      allow read, write: if true;
    }

    // AI recommendations collection
    match /recommendations/{recId} {
      allow read, write: if true;
    }

    // Analytics & event tracking (views, try-ons, cart, purchases)
    match /analyticsEvents/{eventId} {
      allow read, write: if true;
    }

    match /tryOnAnalytics/{eventId} {
      allow read, write: if true;
    }

    match /arDisplayAnalytics/{eventId} {
      allow read, write: if true;
    }

    // Seller analytics collection
    match /sellerAnalytics/{sellerId} {
      allow read, write: if true;
    }
  }
}
