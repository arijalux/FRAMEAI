rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'arijalibnujati@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Optical Catalog
    match /frames/{frameId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(frameId);
    }

    // User Saved Virtual Try-On Looks
    // Only signed-in owners may read or write their own looks; guests keep looks in localStorage.
    match /tryOnLooks/{lookId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(lookId) && isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Account profiles (name, phone, shipping address, PD): private to their owner
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow create, update: if isOwner(userId)
                            && request.resource.data.displayName is string
                            && request.resource.data.displayName.size() <= 120
                            && request.resource.data.phone is string
                            && request.resource.data.phone.size() <= 20
                            && request.resource.data.shippingAddress is map;
      allow delete: if isOwner(userId);
    }

    // Orders with custom lenses
    // Orders contain customer PII (name, email, address): never publicly readable.
    match /orders/{orderId} {
      // Owners may read (and list, with a userId filter) their own orders
      allow get, list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      // Checkout requires an account
      allow create: if isValidId(orderId)
                    && isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.customerEmail is string;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
  }
}
