rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // The one superadmin is fixed here (and in src/lib/firebase.ts), never stored in Firestore.
    // A password account can be opened with any address, so the email must be verified.
    function isSuperAdmin() {
      return isSignedIn()
        && request.auth.token.email is string
        && request.auth.token.email.lower() == 'arijalibnujati@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // Store admins are documents in /admins, which only the superadmin can write
    function isAdmin() {
      return isSuperAdmin() || (isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)));
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Profiles of signed-in users, so the superadmin can find an account by email
    match /users/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isOwner(userId)
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'lastSignInAt'])
                    && request.resource.data.uid == userId
                    && request.resource.data.email == request.auth.token.email.lower()
                    && request.resource.data.displayName is string
                    && request.resource.data.displayName.size() <= 80
                    && request.resource.data.lastSignInAt == request.time;
      allow delete: if false;
    }

    // Store admins: each user can see whether they are one; only the superadmin lists or changes them
    match /admins/{userId} {
      allow get: if isOwner(userId) || isSuperAdmin();
      allow list: if isSuperAdmin();
      allow create, update: if isSuperAdmin()
                    && request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'addedBy', 'addedAt'])
                    && request.resource.data.uid == userId
                    && request.resource.data.email is string
                    && request.resource.data.displayName is string
                    && request.resource.data.addedBy == request.auth.token.email
                    && request.resource.data.addedAt == request.time;
      allow delete: if isSuperAdmin();
    }

    // Optical Catalog
    match /frames/{frameId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin() && isValidId(frameId);
    }

    // User Saved Virtual Try-On Looks
    // Only signed-in owners may read or write their own looks; guests keep looks in localStorage.
    match /tryOnLooks/{lookId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isValidId(lookId) && isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Orders with custom lenses
    // Orders contain customer PII (name, email, address): never publicly readable.
    match /orders/{orderId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isValidId(orderId)
                    && request.resource.data.customerEmail is string
                    && ((isSignedIn() && request.resource.data.userId == request.auth.uid)
                        || (!isSignedIn() && request.resource.data.userId == 'guest-checkout'));
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Custom wooden frame designs sent to BJ Homemade
    // Contain contact details and the cutting files: only admins can list or read them.
    match /customDesigns/{designId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isAdmin();
      allow create: if isValidId(designId)
                    && request.resource.data.customerName is string
                    && request.resource.data.customerName.size() > 0
                    && request.resource.data.customerName.size() <= 80
                    && request.resource.data.contact is string
                    && request.resource.data.contact.size() >= 5
                    && request.resource.data.contact.size() <= 80
                    && request.resource.data.note is string
                    && request.resource.data.note.size() <= 500
                    && request.resource.data.params is map
                    && request.resource.data.status == 'new'
                    && ((isSignedIn() && request.resource.data.userId == request.auth.uid)
                        || (!isSignedIn() && request.resource.data.userId == 'guest'));
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }
  }
}
