<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <radialGradient id="bgGrad" cx="50%" cy="45%" r="65%">
      <stop offset="0%" stop-color="#FAF8F5" />
      <stop offset="60%" stop-color="#F0EDE6" />
      <stop offset="100%" stop-color="#E3DFD5" />
    </radialGradient>
    <filter id="softShadow" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="22" stdDeviation="18" flood-color="#2B241C" flood-opacity="0.18" />
      <feDropShadow dx="0" dy="6" stdDeviation="6" flood-color="#2B241C" flood-opacity="0.12" />
    </filter>
    <linearGradient id="teakGrain" x1="0%" y1="0%" x2="100%" y2="15%">
      <stop offset="0%" stop-color="#965F32" />
      <stop offset="25%" stop-color="#B57D4A" />
      <stop offset="50%" stop-color="#845127" />
      <stop offset="75%" stop-color="#A8713F" />
      <stop offset="100%" stop-color="#7D4920" />
    </linearGradient>
    <linearGradient id="teakHighlight" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" stop-color="rgba(255,255,255,0.35)" />
      <stop offset="40%" stop-color="rgba(255,255,255,0.05)" />
      <stop offset="100%" stop-color="rgba(0,0,0,0.35)" />
    </linearGradient>
    <linearGradient id="lensGlass" x1="20%" y1="0%" x2="80%" y2="100%">
      <stop offset="0%" stop-color="rgba(255,255,255,0.35)" />
      <stop offset="30%" stop-color="rgba(240,245,250,0.15)" />
      <stop offset="70%" stop-color="rgba(210,225,235,0.05)" />
      <stop offset="100%" stop-color="rgba(255,255,255,0.2)" />
    </linearGradient>
  </defs>

  <!-- Surface Backdrop -->
  <rect width="800" height="600" fill="url(#bgGrad)" />

  <!-- Studio Eyewear Cast Shadow -->
  <ellipse cx="400" cy="350" rx="290" ry="70" fill="rgba(40,30,20,0.14)" filter="blur(20px)" />
  <ellipse cx="400" cy="345" rx="240" ry="35" fill="rgba(30,20,10,0.18)" filter="blur(10px)" />

  <g transform="translate(400, 305) scale(1.05)" filter="url(#softShadow)">
    <!-- Folded Wooden Temples Behind -->
    <path d="M-280,-15 C-240,40 -180,65 -100,75 C-60,78 60,78 100,75 C180,65 240,40 280,-15" 
          fill="none" stroke="url(#teakGrain)" stroke-width="16" stroke-linecap="round" opacity="0.9" />
    <path d="M-280,-15 C-240,40 -180,65 -100,75 C-60,78 60,78 100,75 C180,65 240,40 280,-15" 
          fill="none" stroke="url(#teakHighlight)" stroke-width="16" stroke-linecap="round" />

    <!-- Solid Teak Wooden Frame Front (Photo 1 - Rectangle with Rounded Edges) -->
    <!-- Left Rim Exterior -->
    <path d="M -280,-40 
             C -280,-55 -260,-65 -220,-68 
             L -60,-68 
             C -40,-68 -30,-50 -30,-30 
             L -30,20 
             C -30,50 -45,62 -80,64 
             L -230,64 
             C -270,62 -280,45 -280,20 
             Z" 
          fill="url(#teakGrain)" />
    
    <!-- Right Rim Exterior -->
    <path d="M 280,-40 
             C 280,-55 260,-65 220,-68 
             L 60,-68 
             C 40,-68 30,-50 30,-30 
             L 30,20 
             C 30,50 45,62 80,64 
             L 230,64 
             C 270,62 280,45 280,20 
             Z" 
          fill="url(#teakGrain)" />

    <!-- Sculpted Keyhole Bridge -->
    <path d="M -35,-50 
             C -15,-60 15,-60 35,-50 
             C 25,-30 20,-10 30,10 
             C 20,2 -20,2 -30,10 
             C -20,-10 -25,-30 -35,-50 Z" 
          fill="url(#teakGrain)" />

    <!-- Left Lens Cutout -->
    <rect x="-255" y="-50" width="210" height="95" rx="22" fill="#EDE8DF" />
    <rect x="-255" y="-50" width="210" height="95" rx="22" fill="url(#lensGlass)" />
    
    <!-- Right Lens Cutout -->
    <rect x="45" y="-50" width="210" height="95" rx="22" fill="#EDE8DF" />
    <rect x="45" y="-50" width="210" height="95" rx="22" fill="url(#lensGlass)" />

    <!-- Teak Rim Highlights & Chamfer Layer -->
    <path d="M -280,-40 C -280,-55 -260,-65 -220,-68 L -60,-68 C -40,-68 -30,-50 -30,-30 L -30,20 C -30,50 -45,62 -80,64 L -230,64 C -270,62 -280,45 -280,20 Z" 
          fill="url(#teakHighlight)" mix-blend-mode="overlay" />
    <path d="M 280,-40 C 280,-55 260,-65 220,-68 L 60,-68 C 40,-68 30,-50 30,-30 L 30,20 C 30,50 45,62 80,64 L 230,64 C 270,62 280,45 280,20 Z" 
          fill="url(#teakHighlight)" mix-blend-mode="overlay" />

    <!-- Endpiece Brass Rivet Details -->
    <circle cx="-268" cy="-45" r="2.5" fill="#D4AF37" opacity="0.8" />
    <circle cx="-268" cy="-38" r="2.5" fill="#D4AF37" opacity="0.8" />
    <circle cx="268" cy="-45" r="2.5" fill="#D4AF37" opacity="0.8" />
    <circle cx="268" cy="-38" r="2.5" fill="#D4AF37" opacity="0.8" />
  </g>

  <!-- Authentic BJ Homemade Badge -->
  <g transform="translate(400, 530)" opacity="0.85">
    <text text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" letter-spacing="4" fill="#6E5848">BJ Homemade • AUTHENTIC TEAK</text>
    <text y="18" text-anchor="middle" font-family="serif" font-style="italic" font-size="12" fill="#9C7A60">Handcrafted in Indonesia • Product 01</text>
  </g>
</svg>