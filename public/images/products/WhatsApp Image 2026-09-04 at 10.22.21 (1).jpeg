<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 800 600" width="100%" height="100%">
  <defs>
    <radialGradient id="bgGrad4" cx="50%" cy="45%" r="65%">
      <stop offset="0%" stop-color="#FAF8F5" />
      <stop offset="60%" stop-color="#F0EDE6" />
      <stop offset="100%" stop-color="#E3DFD5" />
    </radialGradient>
    <linearGradient id="squareWoodGrain" x1="0%" y1="0%" x2="100%" y2="15%">
      <stop offset="0%" stop-color="#2B2421" />
      <stop offset="25%" stop-color="#423632" />
      <stop offset="50%" stop-color="#261E1B" />
      <stop offset="80%" stop-color="#3A2E2A" />
      <stop offset="100%" stop-color="#211916" />
    </linearGradient>
    <filter id="softShadow4" x="-20%" y="-20%" width="140%" height="150%">
      <feDropShadow dx="0" dy="24" stdDeviation="18" flood-color="#1F1A17" flood-opacity="0.22" />
    </filter>
  </defs>
  <rect width="800" height="600" fill="url(#bgGrad4)" />
  <ellipse cx="400" cy="355" rx="290" ry="70" fill="rgba(30,24,20,0.18)" filter="blur(20px)" />

  <g transform="translate(400, 305) scale(1.05)" filter="url(#softShadow4)">
    <!-- Folded Temples Behind -->
    <path d="M-285,-10 C-240,48 -180,72 -90,80 C-40,82 40,82 90,80 C180,72 240,48 285,-10" 
          fill="none" stroke="url(#squareWoodGrain)" stroke-width="16" stroke-linecap="round" opacity="0.9" />

    <!-- Left Bold Geometric Square Rim (Photo 5) -->
    <path d="M -285,-65 
             L -60,-65 
             C -40,-65 -30,-50 -30,-30 
             L -30,45 
             C -30,65 -45,75 -70,75 
             L -260,75 
             C -280,75 -290,60 -290,40 
             L -290,-40 
             C -290,-60 -285,-65 -285,-65 Z" 
          fill="url(#squareWoodGrain)" />

    <!-- Right Bold Geometric Square Rim (Photo 5) -->
    <path d="M 285,-65 
             L 60,-65 
             C 40,-65 30,-50 30,-30 
             L 30,45 
             C 30,65 45,75 70,75 
             L 260,75 
             C 280,75 290,60 290,40 
             L 290,-40 
             C 290,-60 285,-65 285,-65 Z" 
          fill="url(#squareWoodGrain)" />

    <!-- Heavy Geometric Bridge -->
    <rect x="-40" y="-58" width="80" height="22" rx="4" fill="url(#squareWoodGrain)" />

    <!-- Left Square Lens Cutout -->
    <rect x="-262" y="-42" width="205" height="95" rx="14" fill="#EDE8DF" />
    <rect x="-262" y="-42" width="205" height="95" rx="14" fill="rgba(255,255,255,0.2)" />

    <!-- Right Square Lens Cutout -->
    <rect x="57" y="-42" width="205" height="95" rx="14" fill="#EDE8DF" />
    <rect x="57" y="-42" width="205" height="95" rx="14" fill="rgba(255,255,255,0.2)" />

    <!-- Stepped Brow Horn Bevels -->
    <path d="M -285,-65 L -60,-65" stroke="rgba(255,255,255,0.3)" stroke-width="4" />
    <path d="M 60,-65 L 285,-65" stroke="rgba(255,255,255,0.3)" stroke-width="4" />
  </g>

  <g transform="translate(400, 530)" opacity="0.85">
    <text text-anchor="middle" font-family="sans-serif" font-size="11" font-weight="700" letter-spacing="4" fill="#4A3B32">BJ Homemade • GEOMETRIC SQUARE</text>
    <text y="18" text-anchor="middle" font-family="serif" font-style="italic" font-size="12" fill="#7A6253">Handcrafted Bold Dark Rosewood • Product 03</text>
  </g>
</svg>